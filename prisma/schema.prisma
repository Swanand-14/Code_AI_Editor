
// This is your Prisma schema file,

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  PREMIUM_USER
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @map("user_id") @db.ObjectId 
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model GitHubRepository {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId   
  repoId      Int      @unique
  
  repoFullName    String
  
  htmlUrl     String?
  defaultBranch String
  lastSyncedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, repoFullName])
  

  @@map("github_repositories")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId   
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId 
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  myplayground playground[]
  staredPlayground StarMark[]
  chatMessages  ChatMessage[]
  githubRepositories GitHubRepository[]
  hostedSessions CollabSession[] @relation("HostedSessions")
  collabParticipations CollabParticipant[] @relation("CollabParticipants")
  ownedWorkspaces CollabWorkspace[] @relation("OwnedWorkspaces")
  workspaceDrafts WorkspaceDraft[] @relation("WorkspaceDrafts")

  

  @@map("users")
}

enum Templates {
  REACT
  NEXTJS
  VUE
  ANGULAR
  HONO
  EXPRESS
  FASTIFY
}
model playground {
  id  String @id @default(auto()) @map("_id") @db.ObjectId

  title String
  description String?
  template Templates @default(NEXTJS)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Starmark StarMark[]

  userId String @db.ObjectId
  templateFiles TemplateFile[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("playgrounds")

}

model StarMark {
  id String @id @default(cuid()) @map("_id")
  userId String @db.ObjectId
  playgroundId String @db.ObjectId
  isMarked Boolean 
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references: [id],onDelete:Cascade)
  playground playground @relation(fields:[playgroundId],references: [id],onDelete:Cascade)
  @@unique([userId,playgroundId])
}

model TemplateFile {
  id String @id @default(cuid()) @map("_id")
  content Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plagroundId String @unique @db.ObjectId
  playground playground @relation(fields: [plagroundId], references: [id], onDelete: Cascade)
  @@map("templateFiles")

}

model ChatMessage {
  id String @id @default(cuid()) @map("_id")
  UserId String @db.ObjectId
  role String
  content String
  createdAt DateTime @default(now())
  user User @relation(fields: [UserId], references: [id], onDelete: Cascade)

  @@map("chatMessages")
  @@index([UserId])
}

model CollabSession {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String @unique // This already creates an index, no need for @@index
  projectType String
  templateId String? @db.ObjectId // Made optional
  playgroundId String? @db.ObjectId // Made optional
  templateSnapshot Json?

  repoOwner String?
  repoName String?
  branch String?

  hostId String? @db.ObjectId// Made optional for anonymous users
  hostType String @default("authenticated") // authenticated | anonymous
  hostUser User? @relation("HostedSessions", fields: [hostId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  expiresAt DateTime
  isActive Boolean @default(true)

  participants CollabParticipant[]

  @@map("collab_sessions")
  
  @@index([playgroundId])
  @@index([hostId])
  @@index([templateId])
}

model CollabParticipant {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String @db.ObjectId
  userId String?  @db.ObjectId // Made optional for anonymous participants
  role String @default("viewer") // viewer | editor | host
  displayName String? // Fixed typo: was "dislpayName"
  joinedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  session CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user User? @relation("CollabParticipants", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  @@unique([sessionId, userId])
  @@map("collab_participants")
  @@index([sessionId])
}

model CollabWorkspace {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Identification
  name        String   // User-friendly name
  sessionId   String   @unique // Links to CollabSession
  
  // File storage
  templateData Json  
  
  // Template reference
  originalTemplateId   String?  // For optional reset/comparison
  originalTemplateName String?  // e.g., "NEXTJS", "REACT"
  
  // Ownership
  ownerId     String @db.ObjectId  
  owner       User     @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Metadata
  lastSavedBy String?  // User ID who made last edit
  lastSavedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Stats
  fileCount   Int      @default(0)
  totalSize   Int      @default(0) // in bytes
  
  @@map("collab_workspaces")
  @@index([ownerId])
  
}

model WorkspaceDraft {
id            String   @id @default(auto()) @map("_id") @db.ObjectId
userId        String   @db.ObjectId
sessionId     String?  
repoFullName  String
branch        String
modifiedFiles Json
createdFiles  Json
deletedFiles  Json
lastSaved     DateTime @default(now())
expiresAt     DateTime
// ✅ ADD THE RELATION NAME HERE
user          User     @relation("WorkspaceDrafts", fields: [userId], references: [id], onDelete: Cascade)
@@unique([userId, repoFullName, branch])
@@index([expiresAt])
@@index([userId])
@@index([sessionId])
@@map("workspace_drafts")
}